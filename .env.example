# --- ESOTERIC BANK INTELLIGENCE PLATFORM ---
# ENTERPRISE RUNTIME CONFIGURATION TEMPLATE

# [SYSTEM]
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="ESOTERIC EXECUTIVE COMMAND CENTER"
LOG_LEVEL=INFO

# [SECURITY - JWT]
# Generate via: openssl rand -hex 32
SECRET_KEY=REQUIRED_REPLACE_WITH_SECURE_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# [SECURITY - RBAC]
# Path to RBAC policy definition
RBAC_POLICY_FILE=infra/config/rbac_policy.yaml

# [DATABASE]
DATABASE_URL=postgresql://user:password@localhost:5432/esoteric_db

# [COGNITIVE ENGINE]
# Path to Gemini CLI or local engine wrapper
GEMINI_CLI_PATH=/usr/local/bin/gemini
COGNITION_TIMEOUT_SEC=120
AI_GATEWAY_API_KEY=REQUIRED_REPLACE_WITH_API_KEY

# [INFRASTRUCTURE]
API_PORT=8000
API_HOST=0.0.0.0
ALLOWED_ORIGINS="https://dashboard.esoteric.bank,http://localhost:8501"

# [OBSERVABILITY]
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=True
