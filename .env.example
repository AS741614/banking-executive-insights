# --- ESOTERIC BANK INTELLIGENCE PLATFORM ---
# ENTERPRISE RUNTIME CONFIGURATION TEMPLATE

# [SYSTEM]
ENVIRONMENT=production
RUNTIME_MODE=auto # Options: auto, local, docker, hybrid, frontend-only
DEBUG=False
PROJECT_NAME="ESOTERIC EXECUTIVE COMMAND CENTER"
LOG_LEVEL=INFO

# [SECURITY - JWT]
# Generate via: openssl rand -hex 32
SECRET_KEY=REQUIRED_REPLACE_WITH_SECURE_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# [SECURITY - RBAC]
# Path to RBAC policy definition
RBAC_POLICY_FILE=infra/config/rbac_policy.yaml

# [DATABASE]
DB_USER=esoteric_admin
DB_PASSWORD=governance_secret_2026
DB_NAME=esoteric_bank
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DWH_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# [COGNITIVE ENGINE]
# Path to Gemini CLI or local engine wrapper
GEMINI_CLI_PATH=/usr/local/bin/gemini
COGNITION_TIMEOUT_SEC=120
AI_GATEWAY_API_KEY=REQUIRED_REPLACE_WITH_API_KEY

# [INFRASTRUCTURE]
API_PORT=8000
API_HOST=0.0.0.0
ALLOWED_ORIGINS="https://dashboard.esoteric.bank,http://localhost:8501"

# [OBSERVABILITY]
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=True
