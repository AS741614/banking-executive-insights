# ESOTERIC Platform - Production Environment Variables
# COPY THIS TO .env.production AND UPDATE SECRETS

# --- Global Settings ---
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="ESOTERIC BANK Intelligence Platform"

# --- Security ---
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_REPLACE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (DigitalOcean Managed PostgreSQL) ---
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DWH_URL=postgresql://dwh:password@your-do-db-host:25060/bank_dwh?sslmode=require

# --- API Runtime Tuning ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# --- Observability ---
GRAFANA_PASSWORD=admin_institutional_password_change_me

# --- Paths (Internal to Docker) ---
DATA_DIR=/app/data
LOGS_DIR=/app/logs
